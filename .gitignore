# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv*/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example
# Keep .env.example tracked — it documents required variables without real values

# ── Testing / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
junit.xml

# ── Node / frontend ────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
miniprogram/node_modules/
miniprogram/dist/

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────────
# Local overrides should never be committed — they contain machine-specific paths
# or uncommitted credential tweaks.
docker-compose.override.yml

# ── Secrets / credentials ──────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Alembic generated files ────────────────────────────────────────────────────
# Migration versions are committed; these are runtime artifacts.
alembic/versions/__pycache__/

# ── Misc ───────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/
tmp/
temp/

# Runtime data and browser authentication profiles
storage/
platform-sessions/
secrets/
*.sqlite
*.sqlite3
*.db
*.enc
*.dump
*.sql.gz
~$*
无用备份.docx
