# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aiops:aiops_dev_password@postgres:5432/aiops

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://:aiops_redis_dev@redis:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
# CHANGE IN PRODUCTION: generate with `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-long-random-string-in-production-min-32-chars

# ── Storage ────────────────────────────────────────────────────────────────────
# Use "s3" for both MinIO (dev) and real S3 (prod); use "local" only for tests.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aiops-assets

# ── AI Providers ───────────────────────────────────────────────────────────────
# Add real keys when available; leave blank to stay in mock mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VIDEO_PROVIDER=relay
SEEDANCE_API_KEY=

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
USE_MOCK_DATA=true
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── WeChat ─────────────────────────────────────────────────────────────────────
# Required only when activating WeChat mini program login.
# Production WeChat login requires a real app ID and secret from the WeChat
# Open Platform (https://open.weixin.qq.com).
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── Flower (Celery monitoring) ─────────────────────────────────────────────────
# Format: username:password  — only used in production compose
FLOWER_BASIC_AUTH=admin:change-in-production

# Hotel connector: 订单来了 open platform (values issued by the platform; never commit real ones)
DDLL_BASE_URL=https://open.dingdanll.com
DDLL_API_VERSION=3.0
DDLL_APP_CODE=
DDLL_APP_SECRET=
# Path to our PKCS#8 RSA private key (relative paths resolve against backend/)
DDLL_PRIVATE_KEY_PATH=
DDLL_PLATFORM_PUBLIC_KEY=
DDLL_AES_KEY=
# Encrypts stored third-party credentials. Set explicitly in production.
CREDENTIAL_ENCRYPTION_KEY=

# Video model relay configuration (separate from LLM)
VIDEO_BASE_URL=https://tokenspace.io/v1
VIDEO_MODEL=
VIDEO_API_KEY=
VIDEO_STATUS_URL=
VIDEO_POLL_SECONDS=10
VIDEO_TIMEOUT_SECONDS=1800

# Video output and public reference image access
VIDEO_RESOLUTION=720P
VIDEO_AUDIO=true
PUBLIC_BASE_URL=
