ENVIRONMENT=production
USE_MOCK_DATA=false
DATABASE_URL=postgresql://campfire:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/campfire
REDIS_URL=redis://127.0.0.1:6379/14
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/opt/campfire/shared/storage
CORS_ORIGINS=https://campfire.dawoai.com
PUBLIC_BASE_URL=https://campfire.dawoai.com
TASK_EXECUTION_MODE=inline
EXECUTION_AUTOMATION_ENABLED=true
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
VIDEO_PROVIDER=relay
VIDEO_BASE_URL=
VIDEO_MODEL=
VIDEO_API_KEY=
VIDEO_RESOLUTION=720P
VIDEO_AUDIO=true
WEB_BROWSER_HEADLESS=true
